# ===== Public (safe for the browser) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ===== PRIVATE (server only - never prefix with NEXT_PUBLIC_) =====
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
# Must be an address on a domain verified in Resend, e.g. DEAL <noreply@deal.sa>
EMAIL_FROM=DEAL <noreply@deal.sa>
# Long random string, e.g. output of: openssl rand -hex 32
OTP_SECRET=CHANGE_ME_LONG_RANDOM_STRING
